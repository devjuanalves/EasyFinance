{
  "name": "easyfinance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @easyfinance/web",
    "dev:api": "npm run dev --workspace @easyfinance/api",
    "build": "npm run build --workspace @easyfinance/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "test:e2e": "playwright test",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node database/scripts/prisma.js deploy",
    "db:status": "node database/scripts/prisma.js status",
    "db:seed": "node database/prisma/seed.js",
    "db:test:offline": "node --test database/tests/offline.test.js",
    "db:test": "node --test database/tests/integration.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "vitest": "5.1.0"
  }
}
