        </mxCell>
        
        
        <mxCell id="c2" value="&lt;b&gt;Padrão do projeto: JavaScript em todas as camadas de código (sem TypeScript). O banco é relacional e usa SQL, que é a linguagem de consulta, não uma linguagem de programação substituta do JavaScript.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E8C47A;fontColor=#14263D;fontSize=13;align=left;spacing=13;" vertex="1" parent="1">
          
          
