          <mxGeometry x="70" y="45" width="2140" height="56" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="n2" value="&lt;b&gt;CONVENÇÕES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Banco: PostgreSQL; API Node.js/Express; Prisma ORM usando JavaScript.&lt;br/&gt;PK = chave primária UUID; FK = referência; UNIQUE = unicidade; índices em FKs e filtros frequentes.&lt;br/&gt;Dinheiro: NUMERIC/DECIMAL, nunca float; datas em UTC (timestamptz), data contábil date.&lt;br/&gt;Todas as entidades compartilhadas respeitam workspace_id; autorização ocorre também no backend.&lt;br/&gt;Soft delete/archived_at em registros de histórico quando apropriado; não apagar movimentações financeiras sem auditoria." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.3;align=left;verticalAlign=top;spacing=16;fontSize=16;fontColor=#14263D;overflow=fill;" vertex="1" parent="1">
          
          
