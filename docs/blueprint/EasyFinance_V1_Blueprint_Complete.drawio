        <mxCell id="x4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;fontColor=#14263D;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Observação de escopo V1&lt;/b&gt;&lt;br/&gt;As integrações externas podem começar simples: arquivos locais para importação, e-mails transacionais básicos e IA focada em suporte / insights. Nada substitui revisão humana em lançamentos financeiros sensíveis." vertex="1">
          <mxGeometry x="2700" y="1775" width="1300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E8C47A;fontColor=#14263D;fontSize=13;align=left;spacing=13;" value="&lt;b&gt;Como ler esta página:&lt;/b&gt; à esquerda estão as áreas que o usuário enxerga; no centro, os serviços necessários para a aplicação rodar; à direita, os domínios de dados que sustentam as funcionalidades. Use esta folha como mapa mestre para alinhamento entre produto, design, frontend, backend e banco de dados." vertex="1">
