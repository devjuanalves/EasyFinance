  <diagram id="map-42" name="42 - Mapa geral unificado">
    <mxGraphModel dx="2525" dy="1324" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4200" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="u-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;fontStyle=1;fontColor=#14263D;" value="&lt;b&gt;EASYFINANCE  |  MAPA GERAL UNIFICADO V1&lt;/b&gt;" vertex="1">
          <mxGeometry x="60" y="30" width="2600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="u-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E8C47A;fontColor=#14263D;fontSize=13;align=left;spacing=13;" value="&lt;b&gt;Objetivo:&lt;/b&gt; consolidar em uma única página a visão do produto, módulos do frontend, serviços do backend, banco de dados PostgreSQL e integrações externas. As conexões indicam os principais fluxos de navegação e dados da V1." vertex="1">
          <mxGeometry x="60" y="90" width="3980" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u-legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;fontSize=12;align=left;spacing=10;" value="&lt;b&gt;Leitura rápida:&lt;/b&gt;&lt;br/&gt;• &lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;Azul&lt;/b&gt;&lt;/font&gt; = Telas / módulos da UI (React.js)&lt;br/&gt;• &lt;font color=&quot;#7C3AED&quot;&gt;&lt;b&gt;Roxo&lt;/b&gt;&lt;/font&gt; = Serviços / API (Node.js + Express)&lt;br/&gt;• &lt;font color=&quot;#0D9488&quot;&gt;&lt;b&gt;Verde&lt;/b&gt;&lt;/font&gt; = Domínios / tabelas do banco (PostgreSQL)&lt;br/&gt;• &lt;font color=&quot;#E11D48&quot;&gt;&lt;b&gt;Rosa&lt;/b&gt;&lt;/font&gt; = Integrações externas e processos auxiliares" vertex="1">
          <mxGeometry x="3060" y="25" width="980" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="sec-front" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#14263D;fontSize=18;fontStyle=1;align=left;spacing=16;" value="&lt;b&gt;CAMADA 1 — FRONTEND / EXPERIÊNCIA DO USUÁRIO&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;21 telas organizadas em módulos de navegação&lt;/font&gt;" vertex="1">
          <mxGeometry x="60" y="190" width="1260" height="2030" as="geometry"/>
        </mxCell>
        <mxCell id="sec-back" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#14263D;fontSize=18;fontStyle=1;align=left;spacing=16;" value="&lt;b&gt;CAMADA 2 — BACKEND / SERVIÇOS DE NEGÓCIO&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;API REST em Node.js/Express, validações, permissões e regras&lt;/font&gt;" vertex="1">
          <mxGeometry x="1390" y="190" width="1210" height="2030" as="geometry"/>
        </mxCell>
        <mxCell id="sec-db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#14263D;fontSize=18;fontStyle=1;align=left;spacing=16;" value="&lt;b&gt;CAMADA 3 — BANCO DE DADOS / DOMÍNIOS SQL&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;34 tabelas propostas, separadas por contexto funcional&lt;/font&gt;" vertex="1">
          <mxGeometry x="2670" y="190" width="1370" height="2030" as="geometry"/>
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#14263D;fontSize=14;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;01 — Acesso e Perfil&lt;/b&gt;&lt;br/&gt;F01 Login&lt;br/&gt;F02 Criar conta&lt;br/&gt;F03 Recuperar senha&lt;br/&gt;F04 Onboarding&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;Função: autenticação, criação da conta e configuração inicial do workspace.&lt;/font&gt;" vertex="1">
          <mxGeometry x="90" y="260" width="1200" height="170" as="geometry"/>
        </mxCell>
