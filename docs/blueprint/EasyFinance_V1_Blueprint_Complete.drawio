        <mxCell id="d11" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9F9F4;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#14263D;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Chaves e princípios estruturais&lt;/b&gt;&lt;br/&gt;• Quase todas as tabelas operacionais carregam &lt;b&gt;workspace_id&lt;/b&gt; para multitenancy.&lt;br/&gt;• Integridade: invoices ↔ payments ↔ transactions; assets ↔ positions ↔ valuations; imports ↔ review_queue.&lt;br/&gt;• Segurança: usuários se autenticam individualmente; acesso ao workspace é mediado por workspace_members." vertex="1">
          <mxGeometry x="2700" y="1155" width="1305" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="d12" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9F9F4;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#14263D;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Relações principais&lt;/b&gt;&lt;br/&gt;users → workspaces / workspace_members&lt;br/&gt;workspaces → transactions / invoices / assets / automations / notifications&lt;br/&gt;clients → invoices → invoice_items / invoice_payments&lt;br/&gt;statement_imports → imported_rows → review_queue → transactions&lt;br/&gt;assets → asset_transactions / asset_positions / asset_valuations&lt;br/&gt;ai_conversations → ai_messages / ai_suggestions / ai_insights" vertex="1">
          <mxGeometry x="2700" y="1340" width="1305" height="200" as="geometry"/>
        </mxCell>
