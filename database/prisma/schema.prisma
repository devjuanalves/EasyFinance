  type            String
  title           String
  body            String
  targetType      String?            @map("target_type")
  targetId        String?            @map("target_id") @db.Uuid
  channel         Channel            @default(in_app)
  status          NotificationStatus @default(unread)
  readAt          DateTime?          @map("read_at") @db.Timestamptz(6)
  recipientUserId String             @map("recipient_user_id") @db.Uuid

  workspace     Workspace @relation("Notification_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipientUser User      @relation("Notification_recipientUser", fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([recipientUserId])
  @@index([recipientUserId, workspaceId, status, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  eventType       String   @map("event_type")
  channel         Channel
  enabled         Boolean  @default(true)
  digestFrequency String   @default("immediate") @map("digest_frequency")
  preferredTime   String?  @map("preferred_time")
  workspaceId     String?  @map("workspace_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid

  workspace Workspace? @relation("NotificationPreference_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User       @relation("NotificationPreference_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, workspaceId, eventType, channel])
  @@index([workspaceId])
  @@index([userId])
  @@map("notification_preferences")
}

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId  String   @map("workspace_id") @db.Uuid
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  action       String
  metadataJson Json     @default("{}") @map("metadata_json")
  actorUserId  String?  @map("actor_user_id") @db.Uuid

  workspace Workspace @relation("ActivityLog_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser User?     @relation("ActivityLog_actorUser", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@map("activity_logs")
}
