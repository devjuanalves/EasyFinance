// Block 8: see docs/DATABASE_ARCHITECTURE.md for SQL-only constraints.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  active
  archived
  disabled
}

enum MemberRole {
  owner
  editor
  viewer
}

enum MembershipStatus {
  active
  revoked
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum TransactionType {
  income
  expense
  transfer
}

enum ReviewStatus {
  pending
  reviewed
}

enum TransactionSource {
  manual
  import
  payment
}

enum ImportStatus {
  uploaded
  parsing
  review
  confirmed
  excluded
  failed
}

enum DuplicateDecision {
  unreviewed
  keep_both
  use_original
  exclude
}

enum ClientType {
  individual
  business
}

enum InvoiceLifecycle {
  draft
  issued
  cancelled
}

enum DeliveryStatus {
  prepared
  queued
  sent
  failed
}

enum PaymentStatus {
  pending
  confirmed
  reversed
}

enum RuleStatus {
  active
  paused
  archived
}

enum PreparationMode {
  draft
  review
}

enum Frequency {
  weekly
  fortnightly
  monthly
  quarterly
}

enum InvestmentMovementType {
  buy
  sell
  contribution
  withdrawal
  dividend
  interest
  fee
}

enum MessageRole {
  user
  assistant
  system
}

enum SuggestionStatus {
  pending
  accepted
  rejected
}

enum RunStatus {
  scheduled
  running
  pending_review
  completed
  failed
}

enum NotificationStatus {
  unread
  read
}

enum Channel {
  in_app
  email
}

enum MatchOperator {
  contains
  equals
  starts_with
}

model User {
  Invoice_participant Invoice[]    @relation("Invoice_participant")
  id                  String       @id @default(uuid()) @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  fullName            String       @map("full_name")
  email               String       @unique
  passwordHash        String?      @map("password_hash")
  locale              String       @default("en-AU")
  timezone            String       @default("Australia/Sydney")
  avatarKey           String?      @map("avatar_key")
  status              RecordStatus @default(active)
  preferences         Json         @default("{}")
  emailVerifiedAt     DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  archivedAt          DateTime?    @map("archived_at") @db.Timestamptz(6)

  AuthSession_user               AuthSession[]            @relation("AuthSession_user")
  PasswordResetToken_user        PasswordResetToken[]     @relation("PasswordResetToken_user")
  Workspace_ownerUser            Workspace[]              @relation("Workspace_ownerUser")
  WorkspaceMember_user           WorkspaceMember[]        @relation("WorkspaceMember_user")
  WorkspaceInvitation_invitedBy  WorkspaceInvitation[]    @relation("WorkspaceInvitation_invitedBy")
  WorkspaceInvitation_acceptedBy WorkspaceInvitation[]    @relation("WorkspaceInvitation_acceptedBy")
  ImportBatch_createdBy          ImportBatch[]            @relation("ImportBatch_createdBy")
  Attachment_uploadedBy          Attachment[]             @relation("Attachment_uploadedBy")
  Transaction_createdBy          Transaction[]            @relation("Transaction_createdBy")
  Transaction_participant        Transaction[]            @relation("Transaction_participant")
  CategoryRule_createdBy         CategoryRule[]           @relation("CategoryRule_createdBy")
  Invoice_createdBy              Invoice[]                @relation("Invoice_createdBy")
  Payment_createdBy              Payment[]                @relation("Payment_createdBy")
  RecurringInvoiceRule_createdBy RecurringInvoiceRule[]   @relation("RecurringInvoiceRule_createdBy")
  InvestmentMovement_createdBy   InvestmentMovement[]     @relation("InvestmentMovement_createdBy")
  InvestmentValuation_createdBy  InvestmentValuation[]    @relation("InvestmentValuation_createdBy")
  Conversation_createdBy         Conversation[]           @relation("Conversation_createdBy")
  AiSuggestion_reviewedBy        AiSuggestion[]           @relation("AiSuggestion_reviewedBy")
  AutomationRule_createdBy       AutomationRule[]         @relation("AutomationRule_createdBy")
  Notification_recipientUser     Notification[]           @relation("Notification_recipientUser")
  NotificationPreference_user    NotificationPreference[] @relation("NotificationPreference_user")
  ActivityLog_actorUser          ActivityLog[]            @relation("ActivityLog_actorUser")

  @@map("users")
}

model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  deviceLabel String?   @map("device_label")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  userId      String    @map("user_id") @db.Uuid

  user User @relation("AuthSession_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  userId    String    @map("user_id") @db.Uuid

  user User @relation("PasswordResetToken_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  integrityVersion BigInt       @default(0) @map("integrity_version")
  id               String       @id @default(uuid()) @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  name             String
  baseCurrency     String       @map("base_currency") @db.Char(3)
  timezone         String       @default("Australia/Sydney")
  status           RecordStatus @default(active)
  kind             String       @default("personal")
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(6)
  ownerUserId      String       @map("owner_user_id") @db.Uuid

  WorkspaceMember_workspace        WorkspaceMember[]        @relation("WorkspaceMember_workspace")
  WorkspaceInvitation_workspace    WorkspaceInvitation[]    @relation("WorkspaceInvitation_workspace")
  FinancialAccount_workspace       FinancialAccount[]       @relation("FinancialAccount_workspace")
  ImportBatch_workspace            ImportBatch[]            @relation("ImportBatch_workspace")
  Attachment_workspace             Attachment[]             @relation("Attachment_workspace")
  Transaction_workspace            Transaction[]            @relation("Transaction_workspace")
  TransactionSplit_workspace       TransactionSplit[]       @relation("TransactionSplit_workspace")
  TransactionTransfer_workspace    TransactionTransfer[]    @relation("TransactionTransfer_workspace")
  Category_workspace               Category[]               @relation("Category_workspace")
  CategoryRule_workspace           CategoryRule[]           @relation("CategoryRule_workspace")
  Client_workspace                 Client[]                 @relation("Client_workspace")
  InvoiceTemplate_workspace        InvoiceTemplate[]        @relation("InvoiceTemplate_workspace")
  Invoice_workspace                Invoice[]                @relation("Invoice_workspace")
  InvoiceItem_workspace            InvoiceItem[]            @relation("InvoiceItem_workspace")
  InvoiceDelivery_workspace        InvoiceDelivery[]        @relation("InvoiceDelivery_workspace")
  Payment_workspace                Payment[]                @relation("Payment_workspace")
  PaymentAllocation_workspace      PaymentAllocation[]      @relation("PaymentAllocation_workspace")
  RecurringInvoiceRule_workspace   RecurringInvoiceRule[]   @relation("RecurringInvoiceRule_workspace")
  InvestmentAccount_workspace      InvestmentAccount[]      @relation("InvestmentAccount_workspace")
  Investment_workspace             Investment[]             @relation("Investment_workspace")
  InvestmentMovement_workspace     InvestmentMovement[]     @relation("InvestmentMovement_workspace")
  InvestmentValuation_workspace    InvestmentValuation[]    @relation("InvestmentValuation_workspace")
  Conversation_workspace           Conversation[]           @relation("Conversation_workspace")
  ConversationMessage_workspace    ConversationMessage[]    @relation("ConversationMessage_workspace")
  AiSuggestion_workspace           AiSuggestion[]           @relation("AiSuggestion_workspace")
  AutomationRule_workspace         AutomationRule[]         @relation("AutomationRule_workspace")
  AutomationRun_workspace          AutomationRun[]          @relation("AutomationRun_workspace")
  Notification_workspace           Notification[]           @relation("Notification_workspace")
  ActivityLog_workspace            ActivityLog[]            @relation("ActivityLog_workspace")
  NotificationPreference_workspace NotificationPreference[] @relation("NotificationPreference_workspace")
  ownerUser                        User                     @relation("Workspace_ownerUser", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String           @id @default(uuid()) @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId String           @map("workspace_id") @db.Uuid
  role        MemberRole
  status      MembershipStatus @default(active)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz(6)
  userId      String           @map("user_id") @db.Uuid

  workspace Workspace @relation("WorkspaceMember_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User      @relation("WorkspaceMember_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@unique([workspaceId, userId])
  @@index([workspaceId, createdAt])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId  String           @map("workspace_id") @db.Uuid
  invitedEmail String           @map("invited_email")
  role         MemberRole
  tokenHash    String           @unique @map("token_hash")
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  status       InvitationStatus @default(pending)
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(6)
  invitedById  String           @map("invited_by_id") @db.Uuid
  acceptedById String?          @map("accepted_by_id") @db.Uuid

  workspace  Workspace @relation("WorkspaceInvitation_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy  User      @relation("WorkspaceInvitation_invitedBy", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy User?     @relation("WorkspaceInvitation_acceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([workspaceId, invitedEmail, status])
  @@map("workspace_invitations")
}

model FinancialAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId         String    @map("workspace_id") @db.Uuid
  currency            String    @db.Char(3)
  name                String
  institution         String?
  type                String    @default("manual")
  openingBalanceMinor BigInt    @default(0) @map("opening_balance_minor")
  openingDate         DateTime  @map("opening_date") @db.Date
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)

  workspace                    Workspace     @relation("FinancialAccount_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ImportBatch_financialAccount ImportBatch[] @relation("ImportBatch_financialAccount")
  Transaction_account          Transaction[] @relation("Transaction_account")
  Invoice_account              Invoice[]     @relation("Invoice_account")

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, currency])
  @@index([workspaceId, createdAt])
  @@map("financial_accounts")
}

model ImportBatch {
  id                 String       @id @default(uuid()) @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId        String       @map("workspace_id") @db.Uuid
  currency           String       @db.Char(3)
  periodStart        DateTime?    @map("period_start") @db.Date
  periodEnd          DateTime?    @map("period_end") @db.Date
  status             ImportStatus @default(uploaded)
  rowCount           Int          @default(0) @map("row_count")
  idempotencyKey     String       @map("idempotency_key")
  mapping            Json         @default("{}")
  sourceRows         Json         @default("[]") @map("source_rows")
  reviewDecisions    Json         @default("[]") @map("review_decisions")
  parserVersion      String?      @map("parser_version")
  confirmedAt        DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  financialAccountId String       @map("financial_account_id") @db.Uuid
  fileId             String?      @map("file_id") @db.Uuid
  createdById        String       @map("created_by_id") @db.Uuid

  workspace               Workspace        @relation("ImportBatch_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  financialAccount        FinancialAccount @relation("ImportBatch_financialAccount", fields: [financialAccountId, workspaceId, currency], references: [id, workspaceId, currency], onDelete: Restrict, onUpdate: Restrict)
  file                    Attachment?      @relation("ImportBatch_file", fields: [fileId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  createdBy               User             @relation("ImportBatch_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Transaction_importBatch Transaction[]    @relation("Transaction_importBatch")

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, currency])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([financialAccountId, workspaceId, currency])
  @@index([fileId, workspaceId])
  @@index([createdById])
  @@map("import_batches")
}

model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId  String    @map("workspace_id") @db.Uuid
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  byteSize     BigInt    @map("byte_size")
  checksum     String
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  uploadedById String    @map("uploaded_by_id") @db.Uuid

  workspace        Workspace     @relation("Attachment_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ImportBatch_file ImportBatch[] @relation("ImportBatch_file")
  uploadedBy       User          @relation("Attachment_uploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([uploadedById])
  @@map("attachments")
}

model Transaction {
  clientId               String?           @map("client_id") @db.Uuid
  client                 Client?           @relation("Transaction_client", fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  id                     String            @id @default(uuid()) @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId            String            @map("workspace_id") @db.Uuid
  currency               String            @db.Char(3)
  bookingDate            DateTime          @map("booking_date") @db.Date
  description            String
  originalDescription    String            @map("original_description")
  amountMinor            BigInt            @map("amount_minor")
  originalAmountMinor    BigInt            @map("original_amount_minor")
  originalDate           DateTime          @map("original_date") @db.Date
  type                   TransactionType
  source                 TransactionSource @default(manual)
  reviewStatus           ReviewStatus      @default(pending) @map("review_status")
  manualCategoryOverride Boolean           @default(false) @map("manual_category_override")
  duplicateDecision      DuplicateDecision @default(unreviewed) @map("duplicate_decision")
  sourceReference        String?           @map("source_reference")
  sourceSystem           String?           @map("source_system")
  sourceRow              Int?              @map("source_row")
  sourceData             Json              @default("{}") @map("source_data")
  excludedAt             DateTime?         @map("excluded_at") @db.Timestamptz(6)
  version                Int               @default(1)
  accountId              String            @map("account_id") @db.Uuid
  importBatchId          String?           @map("import_batch_id") @db.Uuid
  categoryId             String?           @map("category_id") @db.Uuid
  duplicateOfId          String?           @map("duplicate_of_id") @db.Uuid
  createdById            String            @map("created_by_id") @db.Uuid
  participantId          String?           @map("participant_id") @db.Uuid

  workspace                               Workspace             @relation("Transaction_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account                                 FinancialAccount      @relation("Transaction_account", fields: [accountId, workspaceId, currency], references: [id, workspaceId, currency], onDelete: Restrict, onUpdate: Restrict)
  importBatch                             ImportBatch?          @relation("Transaction_importBatch", fields: [importBatchId, workspaceId, currency], references: [id, workspaceId, currency], onDelete: Restrict, onUpdate: Restrict)
  category                                Category?             @relation("Transaction_category", fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  duplicateOf                             Transaction?          @relation("Transaction_duplicateOf", fields: [duplicateOfId, workspaceId, currency], references: [id, workspaceId, currency], onDelete: Restrict, onUpdate: Restrict)
  Transaction_duplicateOf                 Transaction[]         @relation("Transaction_duplicateOf")
  createdBy                               User                  @relation("Transaction_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participant                             User?                 @relation("Transaction_participant", fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  TransactionSplit_transaction            TransactionSplit[]    @relation("TransactionSplit_transaction")
  TransactionTransfer_outgoingTransaction TransactionTransfer[] @relation("TransactionTransfer_outgoingTransaction")
  TransactionTransfer_incomingTransaction TransactionTransfer[] @relation("TransactionTransfer_incomingTransaction")
  Payment_transaction                     Payment[]             @relation("Payment_transaction")

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, currency])
  @@unique([importBatchId, sourceRow])
  @@unique([accountId, sourceSystem, sourceReference])
  @@index([clientId, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([accountId, workspaceId, currency])
  @@index([importBatchId, workspaceId, currency])
  @@index([categoryId, workspaceId])
  @@index([duplicateOfId, workspaceId, currency])
  @@index([createdById])
  @@index([participantId])
  @@index([workspaceId, bookingDate])
  @@index([accountId, bookingDate])
  @@map("transactions")
}

model TransactionSplit {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId   String   @map("workspace_id") @db.Uuid
  amountMinor   BigInt   @map("amount_minor")
  note          String?
  transactionId String   @map("transaction_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid

  workspace   Workspace   @relation("TransactionSplit_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transaction Transaction @relation("TransactionSplit_transaction", fields: [transactionId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  category    Category    @relation("TransactionSplit_category", fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([transactionId, workspaceId])
  @@index([categoryId, workspaceId])
  @@map("transaction_splits")
}

model TransactionTransfer {
  id                    String   @id @default(uuid()) @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId           String   @map("workspace_id") @db.Uuid
  currency              String   @db.Char(3)
  linkedAt              DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  outgoingTransactionId String   @map("outgoing_transaction_id") @db.Uuid
  incomingTransactionId String   @map("incoming_transaction_id") @db.Uuid

  workspace           Workspace   @relation("TransactionTransfer_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outgoingTransaction Transaction @relation("TransactionTransfer_outgoingTransaction", fields: [outgoingTransactionId, workspaceId, currency], references: [id, workspaceId, currency], onDelete: Restrict, onUpdate: Restrict)
  incomingTransaction Transaction @relation("TransactionTransfer_incomingTransaction", fields: [incomingTransactionId, workspaceId, currency], references: [id, workspaceId, currency], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, currency])
  @@unique([outgoingTransactionId])
  @@unique([incomingTransactionId])
  @@index([workspaceId, createdAt])
  @@index([outgoingTransactionId, workspaceId, currency])
  @@index([incomingTransactionId, workspaceId, currency])
  @@map("transaction_transfers")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String
  icon        String?
  color       String?
  kind        TransactionType
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(6)

  workspace                 Workspace          @relation("Category_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Transaction_category      Transaction[]      @relation("Transaction_category")
  TransactionSplit_category TransactionSplit[] @relation("TransactionSplit_category")
  CategoryRule_category     CategoryRule[]     @relation("CategoryRule_category")

  @@unique([id, workspaceId])
  @@unique([workspaceId, kind, name])
  @@index([workspaceId, createdAt])
  @@map("categories")
}

model CategoryRule {
  id          String        @id @default(uuid()) @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String
  matchField  String        @map("match_field")
  operator    MatchOperator
  matchValue  String        @map("match_value")
  priority    Int           @default(100)
  isActive    Boolean       @default(true) @map("is_active")
  categoryId  String        @map("category_id") @db.Uuid
  createdById String        @map("created_by_id") @db.Uuid

  workspace Workspace @relation("CategoryRule_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category  Category  @relation("CategoryRule_category", fields: [categoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User      @relation("CategoryRule_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([categoryId, workspaceId])
  @@index([createdById])
  @@index([workspaceId, isActive, priority])
  @@map("category_rules")
}

model Client {
  Transaction_client Transaction[] @relation("Transaction_client")
  id                 String        @id @default(uuid()) @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceId        String        @map("workspace_id") @db.Uuid
  type               ClientType
  name               String
  businessName       String?       @map("business_name")
  email              String?
  phone              String?
