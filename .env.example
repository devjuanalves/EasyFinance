# Copy to .env at repository root. No real credentials here.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Browser-visible: never place secrets in VITE_* variables.
VITE_API_URL=http://localhost:3001
# Replace placeholders locally when database work begins.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/easyfinance?schema=public

# Optional: explicitly enable the simulated auth flow in a local production preview.
# Vite development already enables it. Never use this as production authentication.
# VITE_AUTH_MODE=mock

# Block 8: only disposable loopback databases are accepted by db:migrate/db:seed/db:test.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/easyfinance_test_disposable?schema=public
# Explicit write acknowledgement; never set for production/shared databases.
# EASYFINANCE_DISPOSABLE_DB=yes

# Block 9A: local API mode only. Never use postgres as the runtime identity.
# API_MODE=api
# VITE_AUTH_MODE=api
# API_DATABASE_URL=postgresql://easyfinance_9a_app:PASSWORD@127.0.0.1:5432/easyfinance_block8_test?schema=public
# Keep DATABASE_URL separate for guarded migration/test administration.
