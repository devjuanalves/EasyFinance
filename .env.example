# Copy to .env at repository root. No real credentials here.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Browser-visible: never place secrets in VITE_* variables.
VITE_API_URL=http://localhost:3001
# Replace placeholders locally when database work begins.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/easyfinance?schema=public
